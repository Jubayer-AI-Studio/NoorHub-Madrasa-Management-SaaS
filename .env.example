# NoorHub — Madrasa Management Platform
# Environment Variables — NEVER commit this file to git

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL="postgresql://username:password@localhost:5432/noorhub"
# For local development, PGLite is used automatically (no server needed)

# ==========================================
# REDIS CACHE (Upstash — free tier available)
# ==========================================
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# ==========================================
# AUTHENTICATION
# ==========================================
NEXTAUTH_SECRET="your-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ==========================================
# SMS GATEWAY (for WhatsApp/SMS notifications)
# ==========================================
SMS_API_KEY=""
SMS_API_URL=""

# ==========================================
# PAYMENT GATEWAYS
# ==========================================
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
NAGAD_MERCHANT_ID=""
ROCKET_API_KEY=""

# ==========================================
# WHATSAPP BUSINESS API
# ==========================================
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# ==========================================
# MAPS (OpenStreetMap — FREE, no API key needed)
# ==========================================
# Using Leaflet.js + OpenStreetMap tiles — completely free

# ==========================================
# AI (Noor AI)
# ==========================================
GOOGLE_AI_API_KEY=""

# ==========================================
# APP CONFIG
# ==========================================
NEXT_PUBLIC_APP_NAME="NoorHub"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_VERSION="1.0.0"
